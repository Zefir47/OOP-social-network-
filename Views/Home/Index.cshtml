@{
    ViewData["Title"] = "Стрічка";
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-pa">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Стрічка</h2>
</div>

<div class="posts-grid" id="feed-grid"></div>

@section Scripts {
    <script src="/js/infinite-scroll.js"></script>
    <script>
        InfiniteScroll.init({
            apiUrl: '/Image/GetFeedPosts',
            gridSelector: '#feed-grid',
            pageSize: 12
        });
    </script>
}
