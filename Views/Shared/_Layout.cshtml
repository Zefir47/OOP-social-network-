<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PhotoApp</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/site.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand-lg mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">PhotoApp</a>
        <button class="navbar-toggler" type="button"
                data-bs-toggle="collapse" data-bs-target="#navMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navMenu">
            <ul class="navbar-nav ms-auto align-items-center gap-1">
                @if (User.Identity.IsAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/">Стрічка</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Image/MyPosts">Мої пости</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Image/Upload">+ Публікація</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Image/Users">Люди</a>
                    </li>
                    <li class="nav-item">
                        <form method="post" action="/Account/Logout" style="margin:0;">
                            <button class="btn btn-link nav-link" type="submit">Вийти</button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Login">Увійти</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Register">Реєстрація</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

<div class="container pb-5">
    @RenderBody()
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)
<script>
function toggleComments(id) {
    const el = document.getElementById(id);
    if (!el) return;
    const isHidden = el.style.display === 'none' || el.style.display === '';
    el.style.display = isHidden ? 'flex' : 'none';
    if (isHidden) {
        const ta = el.querySelector('textarea');
        if (ta) ta.focus();
    }
}
</script>
</body>
</html>
