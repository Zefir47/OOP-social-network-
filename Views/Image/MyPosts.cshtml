@model IEnumerable<PhotoApp.Models.ImagePost>

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PhotoApp.Models
@inject UserManager<PhotoApp.Models.ApplicationUser> UserManager
@inject PhotoApp.Data.ApplicationDbContext Db

@{
    ViewData["Title"] = "Мої пости";
    var currentUserId = UserManager.GetUserId(User);
    ViewBag.CurrentUserId = currentUserId;

    var myForwards = Db.PostInteractions
        .Include(pi => pi.OriginalPost).ThenInclude(p => p.User)
        .Include(pi => pi.OriginalPost).ThenInclude(p => p.Likes)
        .Include(pi => pi.OriginalPost).ThenInclude(p => p.Comments)
        .Where(pi => pi.Type == InteractionType.Forward && pi.ActorId == currentUserId)
        .OrderByDescending(pi => pi.CreatedAt)
        .ToList();
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-pa">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Мої публікації</h2>
    <a href="/Image/Upload" class="btn-pa-primary">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
        </svg>
        Нова публікація
    </a>
</div>

<div class="posts-grid">
    @foreach (var post in Model)
    {
        @await Html.PartialAsync("_PostCard", post)
    }

    @foreach (var fwd in myForwards)
    {
        <div class="forward-card">
            <div class="forward-card__header">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                Переслано від
                <a href="/Image/Profile/@fwd.OriginalPost.UserId">@fwd.OriginalPost.User.UserName</a>
            </div>
            <a href="/Image/Profile/@fwd.OriginalPost.UserId">
                <img src="@fwd.OriginalPost.ImagePath" class="forward-card__img" />
            </a>
            <div class="forward-card__body">
                @if (!string.IsNullOrWhiteSpace(fwd.Comment))
                {
                    <div class="forward-card__comment">@fwd.Comment</div>
                }
                <div class="forward-card__original">
                    <span class="forward-card__original-author">@fwd.OriginalPost.User.UserName</span>
                    <span class="forward-card__original-desc">@fwd.OriginalPost.Description</span>
                </div>
                <div class="forward-card__stats">
                    <span>❤️ @fwd.OriginalPost.Likes.Count</span>
                    <span>💬 @fwd.OriginalPost.Comments.Count</span>
                    <span class="forward-card__date">@fwd.CreatedAt.ToString("dd.MM.yyyy")</span>
                </div>
            </div>
        </div>
    }

    @if (!Model.Any() && !myForwards.Any())
    {
        <p class="text-muted">Публікацій ще немає.</p>
    }
</div>
