@{
    ViewData["Title"] = "Переслати";
    var original = ViewBag.OriginalPost as PhotoApp.Models.ImagePost;
}

<div class="form-page">
    <h2 class="form-page__title">↪️ Переслати публікацію</h2>

    <div class="form-page__preview">
        <div class="form-page__preview-header" style="color: var(--pa-success);">
            Публікація від <strong>@original.User.UserName</strong>
        </div>
        <a href="/Image/Profile/@original.UserId">
            <img src="@original.ImagePath" />
        </a>
        <p class="form-page__preview-desc">@original.Description</p>
    </div>

    <form method="post">
        <input type="hidden" name="id" value="@original.Id" />

        <div class="mb-3">
            <label>Ваш коментар <span style="font-weight:400; color:var(--pa-muted)">(необов'язково)</span></label>
            <textarea name="comment" rows="3"
                      maxlength="500"
                      placeholder="Додайте щось від себе..."></textarea>
        </div>

        <div class="form-page__actions">
            <button type="submit" class="btn-pa-primary" style="background:var(--pa-success);">
                Переслати
            </button>
            <a href="javascript:history.back()" class="btn-pa-outline">Скасувати</a>
        </div>
    </form>
</div>
